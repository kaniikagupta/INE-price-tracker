# ============================================================
# INE Product Price Tracker - Backend Environment Variables
# ============================================================

# Server Port
PORT=5000

# CORS Allowed Origin
FRONTEND_URL=http://localhost:5173

# Supabase PostgreSQL Configuration
# In production on Render, provide these from your Supabase project settings.
# If left empty locally, the backend automatically uses SQLite fallback (database/tracker.sqlite).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cron Endpoint Secret for cron-job.org
# Must match the 'x-cron-secret' header sent by cron-job.org
CRON_SECRET=super_secret_cron_token_ine_2026

# Scraper Configuration
SCRAPER_HEADLESS=true
MAX_ATTEMPTS=3
PAGE_TIMEOUT=30000
ELEMENT_TIMEOUT=10000
DEFAULT_SCRAPE_FREQUENCY_MINUTES=120
